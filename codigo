/**
 * PROZ EDUCAÇÃO / SISTEMAS INTELIGENTES
 * Projeto: Buscador de Músicas & Tradutor de Letras via IA
 * API Externa: Genius API
 * Servidor IA: Hugging Face Router API (Serverless Nuvem)
 */

// --- CARREGADOR MANUAL DO ARQUIVO .ENV ---
if (file_exists(__DIR__ . '/.env')) {
    $envLines = file(__DIR__ . '/.env', FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES);
    foreach ($envLines as $line) {
        $line = trim($line);
        if (strpos($line, '#') === 0 || empty($line)) continue;
        if (strpos($line, '=') !== false) {
            list($name, $value) = explode('=', $line, 2);
            $name = trim($name);
            $value = trim($value, " \t\n\r\0\x0B\"'");
            putenv("{$name}={$value}");
            $_ENV[$name] = $value;
        }
    }
}

// --- FUNÇÃO DE REQUISIÇÃO HUGGING FACE ---
function chamarHuggingFace(string $url, array $payload, string $token): array {
    $ch = curl_init($url);
    curl_setopt_array($ch, [
        CURLOPT_RETURNTRANSFER => true,
        CURLOPT_POST           => true,
        CURLOPT_POSTFIELDS     => json_encode($payload),
        CURLOPT_SSL_VERIFYPEER => false,
        CURLOPT_SSL_VERIFYHOST => false,
        CURLOPT_FOLLOWLOCATION => true,
        CURLOPT_TIMEOUT        => 30,
        CURLOPT_IPRESOLVE      => CURL_IPRESOLVE_V4,
        CURLOPT_HTTPHEADER     => [
            "Authorization: Bearer " . trim($token),
            "Content-Type: application/json",
            "User-Agent: Mozilla/5.0 (Windows NT 10.0; Win64; x64)"
        ]
    ]);

    $response = curl_exec($ch);
    $httpCode = curl_getinfo($ch, CURLINFO_HTTP_CODE);
    curl_close($ch);

    return ['code' => $httpCode, 'response' => $response];
}

$geniusToken = getenv('GENIUS_TOKEN') ?: ($_ENV['GENIUS_TOKEN'] ?? '');
$hfToken     = getenv('HF_TOKEN')     ?: ($_ENV['HF_TOKEN'] ?? '');

$trechoDigitado    = '';
$musicaEncontrada  = null;
$traducaoResultado = null;
$erroMsg           = null;

if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    $trechoRaw = filter_input(INPUT_POST, 'trecho', FILTER_DEFAULT);
    $trechoDigitado = $trechoRaw ? trim($trechoRaw) : '';

    if (!empty($trechoDigitado)) {
        if (empty($geniusToken)) {
            $erroMsg = "Token do Genius não configurado no arquivo .env.";
        } else {
            // --- 1. BUSCA MÚSICA NO GENIUS ---
            $geniusUrl = "https://api.genius.com/search?q=" . urlencode($trechoDigitado);
            $chGenius = curl_init($geniusUrl);
            curl_setopt_array($chGenius, [
                CURLOPT_RETURNTRANSFER => true,
                CURLOPT_SSL_VERIFYPEER => false,
                CURLOPT_SSL_VERIFYHOST => false,
                CURLOPT_IPRESOLVE      => CURL_IPRESOLVE_V4,
                CURLOPT_TIMEOUT        => 30,
                CURLOPT_HTTPHEADER     => [
                    "Authorization: Bearer " . trim($geniusToken),
                    "User-Agent: Mozilla/5.0 (Windows NT 10.0; Win64; x64)"
                ]
            ]);

            $responseGenius = curl_exec($chGenius);
            $httpCodeGenius = curl_getinfo($chGenius, CURLINFO_HTTP_CODE);
            curl_close($chGenius);

            if ($httpCodeGenius === 200) {
                $dadosGenius = json_decode($responseGenius, true);
                $hits = $dadosGenius['response']['hits'] ?? [];

                if (!empty($hits)) {
                    $primeiroResultado = $hits[0]['result'];
                    $musicaEncontrada = [
                        'titulo'    => $primeiroResultado['title'],
                        'artista'   => $primeiroResultado['primary_artist']['name'],
                        'capa'      => $primeiroResultado['song_art_image_thumbnail_url'] ?? '',
                        'genius_url'=> $primeiroResultado['url'] ?? '#'
                    ];

                    // --- 2. TRADUZ NO HUGGING FACE ROUTER ---
                    if (empty($hfToken)) {
                        $erroMsg = "Música encontrada, mas o Token do Hugging Face não foi configurado no .env.";
                    } else {
                        // Tentativa 1: Modelo Principal
                        $urlPrincipal = "https://router.huggingface.co/hf-inference/models/Musixmatch/opus-mt-en-romance";
                        $payloadPrincipal = ["inputs" => ">>por<< " . $trechoDigitado];
                        $resPrincipal = chamarHuggingFace($urlPrincipal, $payloadPrincipal, $hfToken);

                        if ($resPrincipal['code'] === 200) {
                            $dadosHf = json_decode($resPrincipal['response'], true);
                            if (is_array($dadosHf) && isset($dadosHf[0]['translation_text'])) {
                                $traducaoResultado = $dadosHf[0]['translation_text'];
                            }
                        }

                        // Tentativa 2: Fallback (Helsinki-NLP)
                        if (empty($traducaoResultado)) {
                            $urlFallback = "https://router.huggingface.co/hf-inference/models/Helsinki-NLP/opus-mt-tc-big-en-pt";
                            $payloadFallback = ["inputs" => $trechoDigitado];
                            $resFallback = chamarHuggingFace($urlFallback, $payloadFallback, $hfToken);

                            if ($resFallback['code'] === 200) {
                                $dadosHf = json_decode($resFallback['response'], true);
                                if (is_array($dadosHf) && isset($dadosHf[0]['translation_text'])) {
                                    $traducaoResultado = $dadosHf[0]['translation_text'];
                                }
                            } elseif ($resFallback['code'] === 503) {
                                $erroMsg = "O modelo de IA está inicializando na nuvem. Aguarde alguns segundos e tente novamente.";
                            } elseif ($resFallback['code'] === 401) {
                                $erroMsg = "Token do Hugging Face inválido (HTTP 401). Verifique a chave no .env.";
                            } else {
                                $erroMsg = "Erro na requisição à IA (HTTP " . $resFallback['code'] . ").";
                            }
                        }
                    }
                } else {
                    $erroMsg = "Nenhuma música foi encontrada para esse trecho.";
                }
            } elseif ($httpCodeGenius === 401) {
                $erroMsg = "Erro de autenticação na API do Genius (HTTP 401). Verifique seu GENIUS_TOKEN.";
            } else {
                $erroMsg = "Erro de conexão com a API do Genius (HTTP {$httpCodeGenius}).";
            }
        }
    }
}
